#!/bin/zsh
set -euo pipefail

SCRIPT_DIR=${0:A:h}
REPO_ROOT=${SCRIPT_DIR:h}
MIGRATION="$REPO_ROOT/supabase/migrations/20260810000100_pilot_validation.sql"
ONGOING_MIGRATION="$REPO_ROOT/supabase/migrations/20260810000200_pilot_ongoing_contribution.sql"
SERVICE_ROLE_MIGRATION="$REPO_ROOT/supabase/migrations/20260811000100_pilot_service_role_access.sql"
ENROLLMENT_MIGRATION="$REPO_ROOT/supabase/migrations/20260820000100_pilot_enrollment_idempotency.sql"
API_SOURCE="$REPO_ROOT/supabase/functions/pilot-api/index.ts"
SHARED_SOURCE="$REPO_ROOT/supabase/functions/_shared/pilot.ts"
ANALYSIS_STORE="$REPO_ROOT/ios/Evolv/Services/Analysis/AnalysisStore.swift"
EXPECTED_ANALYSIS_VERSION=$(awk '/static let currentAnalysisVersion =/ { print $NF; exit }' "$ANALYSIS_STORE")
[[ "$EXPECTED_ANALYSIS_VERSION" == <-> ]] || {
  print -u2 "Pilot security gate failed: current analysis version is missing or invalid"
  exit 1
}

fail() { print -u2 "Pilot security gate failed: $1"; exit 1; }
stage() { print "Live gate: $1"; }
CURL_TIMEOUT=(--http1.1 --connect-timeout 10 --max-time 30)
expect_status() {
  local expected=$1
  shift
  local actual
  actual=$(curl "${CURL_TIMEOUT[@]}" -sS -o /dev/null -w '%{http_code}' "$@")
  [[ "$actual" == "$expected" ]] || fail "expected HTTP $expected, received $actual"
}
expect_status_eventually() {
  local expected=$1
  local attempts=$2
  shift 2
  local actual="transport_error"
  local attempt
  for (( attempt = 1; attempt <= attempts; attempt++ )); do
    if actual=$(curl "${CURL_TIMEOUT[@]}" --max-time 15 -sS -o /dev/null -w '%{http_code}' "$@"); then
      [[ "$actual" == "$expected" ]] && return 0
    fi
  done
  fail "expected HTTP $expected after $attempts safe probe attempts, received $actual"
}

rg -q "enable row level security" "$MIGRATION" || fail "RLS is not enabled"
rg -q "force row level security" "$MIGRATION" || fail "RLS is not forced"
rg -q "revoke all on table storage.objects from public, anon, authenticated" "$MIGRATION" || fail "storage reads are not revoked"
rg -q "public.*false" "$MIGRATION" || fail "pilot bucket is not private"
rg -q "consent_object_mismatch" "$MIGRATION" "$API_SOURCE" || fail "consent/file constraint is missing"
rg -q "createSignedUploadUrl" "$API_SOURCE" || fail "short-lived upload authorization is missing"
rg -q "inspectPilotObject" "$API_SOURCE" || fail "supported storage object verification is missing"
if rg -q '\.schema\("storage"\)' "$API_SOURCE"; then
  fail "storage verification must not query the unexposed storage schema through PostgREST"
fi
rg -q "deleteParticipantData" "$API_SOURCE" "$SHARED_SOURCE" || fail "withdrawal deletion is missing"
rg -q "pilot-ongoing-v1" "$ONGOING_MIGRATION" "$API_SOURCE" || fail "separate ongoing consent is missing"
rg -q "pilot_consistency_required" "$ONGOING_MIGRATION" || fail "ongoing contribution prerequisite is missing"
rg -q "max_participants" "$ONGOING_MIGRATION" || fail "invite cohort capacity is missing"
rg -q "pilot_redeem_invite_v2" "$ENROLLMENT_MIGRATION" "$API_SOURCE" || fail "retry-safe enrollment is missing"
rg -q "pilot_validate_invite" "$ENROLLMENT_MIGRATION" "$API_SOURCE" || fail "non-consuming invitation validation is missing"
rg -q "client_verifier_v2" "$ENROLLMENT_MIGRATION" "$SHARED_SOURCE" || fail "client-generated credential verification is missing"
rg -q "to service_role" "$SERVICE_ROLE_MIGRATION" || fail "private pilot tables are unavailable to Edge Functions"
rg -q "from public, anon, authenticated" "$SERVICE_ROLE_MIGRATION" || fail "private pilot sequences are exposed to client roles"
rg -q 'route === "health"' "$API_SOURCE" || fail "deployment health contract is missing"
rg -q 'global:participant' "$SHARED_SOURCE" || fail "participant endpoint lacks a global abuse ceiling"
rg -q 'unsupported_analysis_version' "$SHARED_SOURCE" || fail "analysis-version payload validation is missing"
rg -q 'storageError.*object_delete_failed' "$SHARED_SOURCE" || fail "retention does not fail closed on storage deletion errors"
if rg -n "console\.(log|debug|info)|logger\." "$REPO_ROOT/supabase/functions"; then
  fail "edge functions must not log pilot payloads or URLs"
fi
if git -C "$REPO_ROOT" ls-files 'private/pilot/*' | rg -q .; then
  fail "researcher private files are Git-tracked"
fi
if git -C "$REPO_ROOT" grep -n --fixed-strings "BEGIN EC PRIVATE KEY" -- . ':!scripts/test-evolv-pilot-security' >/dev/null; then
  fail "a private EC key is Git-tracked"
fi
print "Static pilot privacy and access-control gates passed."

INVITE=${EVOLV_PILOT_TEST_INVITE:-}
[[ -n "$INVITE" ]] || {
  print "Live penetration checks skipped. Set EVOLV_PILOT_TEST_INVITE to a disposable one-use invite."
  exit 0
}

API_BASE=${EVOLV_PILOT_API_URL:-https://zaqbnznrfvapbgrjxskv.supabase.co/functions/v1/pilot-api}
PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY:-}
[[ -n "$PUBLISHABLE_KEY" ]] || fail "SUPABASE_PUBLISHABLE_KEY is required for live checks"
TEST_DIR=$(mktemp -d)
trap '[[ "$TEST_DIR" == /var/folders/* || "$TEST_DIR" == /tmp/* ]] && rm -rf -- "$TEST_DIR"' EXIT INT TERM
HEADERS=(-H "apikey: $PUBLISHABLE_KEY" -H "authorization: Bearer $PUBLISHABLE_KEY" -H 'content-type: application/json')

stage "health contract"
curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" --data '{}' "$API_BASE/health" > "$TEST_DIR/health.json"
jq -e '
  .status == "ok" and
  .service == "evolv-pilot" and
  .schemaVersion == 2 and
  .analysisVersion == $analysis_version and
  .minimumAnalysisVersion == 4 and
  (.consentVersions | sort) == (["pilot-consent-v1", "pilot-ongoing-v1"] | sort)
' --argjson analysis_version "$EXPECTED_ANALYSIS_VERSION" "$TEST_DIR/health.json" >/dev/null || fail "deployed health contract does not match this app"

stage "unauthorized access"
expect_status 401 -X POST "${HEADERS[@]}" --data '{}' "$API_BASE/status"
{
  print -n '{"padding":"'
  head -c 525000 /dev/zero | tr '\0' 'a'
  print -n '"}'
} > "$TEST_DIR/oversized.json"
stage "payload ceiling"
expect_status_eventually 413 5 -X POST "${HEADERS[@]}" --data-binary "@$TEST_DIR/oversized.json" "$API_BASE/enroll"

jq -n --arg code "$INVITE" '{invite_code:$code}' > "$TEST_DIR/validate.json"
stage "non-consuming invitation validation"
curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" --data-binary "@$TEST_DIR/validate.json" "$API_BASE/invites/validate" > "$TEST_DIR/validated.json"
jq -e '.status == "valid" and (.study_name | type == "string")' "$TEST_DIR/validated.json" >/dev/null || fail "invitation validation did not return valid metadata"

TOKEN=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\r\n')
DELETION_CODE=$(openssl rand -hex 20 | tr '[:lower:]' '[:upper:]')
ENROLLMENT_IDEMPOTENCY=$(uuidgen | tr '[:upper:]' '[:lower:]')
TOKEN_VERIFIER=$(print -rn -- "$TOKEN" | shasum -a 256 | awk '{print $1}')
RECOVERY_VERIFIER=$(print -rn -- "$DELETION_CODE" | shasum -a 256 | awk '{print $1}')
jq -n --arg code "$INVITE" --arg idem "$ENROLLMENT_IDEMPOTENCY" \
  --arg token_verifier "$TOKEN_VERIFIER" --arg recovery_verifier "$RECOVERY_VERIFIER" \
  '{invite_code:$code,enrollment_idempotency_key:$idem,participant_token_verifier:$token_verifier,recovery_code_verifier:$recovery_verifier}' > "$TEST_DIR/enroll.json"
stage "retry-safe one-use enrollment"
curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" --data-binary "@$TEST_DIR/enroll.json" "$API_BASE/enroll" > "$TEST_DIR/enrolled.json"
jq -e '.participant_id and .study_id and (.participant_token | not) and (.deletion_code | not)' "$TEST_DIR/enrolled.json" >/dev/null || fail "enrollment did not return metadata-only outcome"
AUTH=(-H "x-evolv-participant-token: $TOKEN")

curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" --data-binary "@$TEST_DIR/enroll.json" "$API_BASE/enroll" > "$TEST_DIR/enrolled-retry.json"
[[ "$(jq -r '.participant_id' "$TEST_DIR/enrolled.json")" == "$(jq -r '.participant_id' "$TEST_DIR/enrolled-retry.json")" ]] || fail "enrollment replay changed participant identity"
expect_status 409 -X POST "${HEADERS[@]}" --data-binary "@$TEST_DIR/validate.json" "$API_BASE/invites/validate"
jq --arg idem "$(uuidgen | tr '[:upper:]' '[:lower:]')" '.enrollment_idempotency_key=$idem' "$TEST_DIR/enroll.json" > "$TEST_DIR/enroll-new-operation.json"
expect_status 409 -X POST "${HEADERS[@]}" --data-binary "@$TEST_DIR/enroll-new-operation.json" "$API_BASE/enroll"
expect_status 401 -X POST "${HEADERS[@]}" -H 'x-evolv-participant-token: forged-participant-token-that-is-not-valid' --data '{}' "$API_BASE/status"

SESSION_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')
SUBMISSION_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')
IDEMPOTENCY_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')
NOW=$(date -u +%Y-%m-%dT%H:%M:%SZ)
stage "consistency submission validation and replay"
jq -n \
  --arg session "$SESSION_ID" --arg submission "$SUBMISSION_ID" --arg idem "$IDEMPOTENCY_ID" --arg now "$NOW" \
  --argjson analysis_version "$EXPECTED_ANALYSIS_VERSION" \
  '{
    client_submission_id:$submission,
    idempotency_key:$idem,
    consent:{version:"pilot-consent-v1",adult_confirmed:true,share_scope:"results_only",accepted_at:$now},
    results:{
      schema_version:1,
      local_session_id:$session,
      session_result:"limited_evidence",
      started_at:$now,
      completed_at:$now,
      app_build:"security-test",
      analysis_version:$analysis_version,
      threshold_set_identifier:"engineering-v1",
      device_model:"test",
      operating_system_version:"test",
      camera_position:"front",
      sets:[range(1;6) as $set | {
        set_number:$set,
        regions:[
          {region:"shoulders",status:"unavailable",fused_delta:null,unavailable_reason_code:"required_pose_evidence_unavailable",contributions:[]},
          {region:"chest",status:"unavailable",fused_delta:null,unavailable_reason_code:"required_pose_evidence_unavailable",contributions:[]},
          {region:"waist",status:"unavailable",fused_delta:null,unavailable_reason_code:"required_pose_evidence_unavailable",contributions:[]}
        ],
        failure_reason_codes_by_pose:({
          ("set_" + ($set|tostring) + ".back.hipLandmarks"):"hip_landmarks_unavailable",
          ("set_" + ($set|tostring) + ".side.comparability"):"pose_not_comparable"
        })
      }]
    },
    wrapped_key:null,
    objects:[]
  }' > "$TEST_DIR/init.json"

jq '.consent.adult_confirmed=false' "$TEST_DIR/init.json" > "$TEST_DIR/forged-consent.json"
expect_status 400 -X POST "${HEADERS[@]}" "${AUTH[@]}" --data-binary "@$TEST_DIR/forged-consent.json" "$API_BASE/submissions/init"
jq --argjson unsupported "$(( EXPECTED_ANALYSIS_VERSION + 1 ))" \
  '.results.analysis_version=$unsupported' "$TEST_DIR/init.json" > "$TEST_DIR/future-analysis.json"
expect_status 400 -X POST "${HEADERS[@]}" "${AUTH[@]}" --data-binary "@$TEST_DIR/future-analysis.json" "$API_BASE/submissions/init"
jq '.consent.share_scope="results_and_selected_photos"' "$TEST_DIR/init.json" > "$TEST_DIR/photo-without-selection.json"
expect_status 400 -X POST "${HEADERS[@]}" "${AUTH[@]}" --data-binary "@$TEST_DIR/photo-without-selection.json" "$API_BASE/submissions/init"
jq '.objects=[{object_id:"00000000-0000-4000-8000-000000000001",set_number:1,pose:"front",sha256:("a"*64),byte_count:100}] | .wrapped_key={algorithm:"forged"}' "$TEST_DIR/init.json" > "$TEST_DIR/results-with-photo.json"
expect_status 400 -X POST "${HEADERS[@]}" "${AUTH[@]}" --data-binary "@$TEST_DIR/results-with-photo.json" "$API_BASE/submissions/init"

curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" "${AUTH[@]}" --data-binary "@$TEST_DIR/init.json" "$API_BASE/submissions/init" > "$TEST_DIR/initialized.json"
REMOTE_SUBMISSION=$(jq -r '.submission_id' "$TEST_DIR/initialized.json")
[[ "$REMOTE_SUBMISSION" != null ]] || fail "results-only initialization failed"
jq -e '.uploads == []' "$TEST_DIR/initialized.json" >/dev/null ||
  fail "results-only initialization unexpectedly created photo objects"
curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" "${AUTH[@]}" --data-binary "@$TEST_DIR/init.json" "$API_BASE/submissions/init" > "$TEST_DIR/replayed.json"
[[ "$(jq -r '.submission_id' "$TEST_DIR/replayed.json")" == "$REMOTE_SUBMISSION" ]] || fail "idempotent replay created a different submission"

jq -n --arg submission "$REMOTE_SUBMISSION" --arg idem "$IDEMPOTENCY_ID" '{submission_id:$submission,idempotency_key:$idem}' > "$TEST_DIR/complete.json"
curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" "${AUTH[@]}" --data-binary "@$TEST_DIR/complete.json" "$API_BASE/submissions/complete" > "$TEST_DIR/receipt-one.json"
curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" "${AUTH[@]}" --data-binary "@$TEST_DIR/complete.json" "$API_BASE/submissions/complete" > "$TEST_DIR/receipt-two.json"
[[ "$(jq -r '.receipt_code' "$TEST_DIR/receipt-one.json")" == "$(jq -r '.receipt_code' "$TEST_DIR/receipt-two.json")" ]] || fail "duplicate completion changed the receipt"

PROGRESS_SESSION=$(uuidgen | tr '[:upper:]' '[:lower:]')
PROGRESS_SUBMISSION=$(uuidgen | tr '[:upper:]' '[:lower:]')
PROGRESS_IDEMPOTENCY=$(uuidgen | tr '[:upper:]' '[:lower:]')
stage "separate ongoing consent"
jq -n \
  --arg session "$PROGRESS_SESSION" --arg submission "$PROGRESS_SUBMISSION" --arg idem "$PROGRESS_IDEMPOTENCY" --arg now "$NOW" \
  --argjson analysis_version "$EXPECTED_ANALYSIS_VERSION" \
  '{client_submission_id:$submission,idempotency_key:$idem,consent:{version:"pilot-ongoing-v1",adult_confirmed:true,share_scope:"results_only",accepted_at:$now},results:{schema_version:1,contribution_type:"progress_scan",local_session_id:$session,session_result:"comparable",started_at:$now,completed_at:$now,app_build:"security-test",analysis_version:$analysis_version,threshold_set_identifier:"engineering-v1",device_model:"test",operating_system_version:"test",camera_position:"front",regions:[],failure_reason_codes_by_pose:{}},wrapped_key:null,objects:[]}' > "$TEST_DIR/progress-init.json"
jq '.consent.version="pilot-consent-v1"' "$TEST_DIR/progress-init.json" > "$TEST_DIR/progress-wrong-consent.json"
expect_status 400 -X POST "${HEADERS[@]}" "${AUTH[@]}" --data-binary "@$TEST_DIR/progress-wrong-consent.json" "$API_BASE/submissions/init"
curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" "${AUTH[@]}" --data-binary "@$TEST_DIR/progress-init.json" "$API_BASE/submissions/init" > "$TEST_DIR/progress-initialized.json"
PROGRESS_REMOTE=$(jq -r '.submission_id' "$TEST_DIR/progress-initialized.json")
[[ "$PROGRESS_REMOTE" != null ]] || fail "ongoing results-only initialization failed"
jq -n --arg submission "$PROGRESS_REMOTE" --arg idem "$PROGRESS_IDEMPOTENCY" '{submission_id:$submission,idempotency_key:$idem}' > "$TEST_DIR/progress-complete.json"
expect_status 200 -X POST "${HEADERS[@]}" "${AUTH[@]}" --data-binary "@$TEST_DIR/progress-complete.json" "$API_BASE/submissions/complete"
curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" "${AUTH[@]}" --data '{}' "$API_BASE/status" > "$TEST_DIR/status.json"
jq -e '.completed_consistency_tests == 1 and .completed_progress_scans == 1' "$TEST_DIR/status.json" >/dev/null || fail "status did not classify consistency and progress submissions"

stage "selected-photo upload, verification, and replay"
head -c 64 /dev/zero | tr '\0' 'e' > "$TEST_DIR/ciphertext.bin"
head -c 7 /dev/zero | tr '\0' 'x' > "$TEST_DIR/wrong-size.bin"
CIPHERTEXT_BYTES=$(stat -f '%z' "$TEST_DIR/ciphertext.bin" 2>/dev/null || stat -c '%s' "$TEST_DIR/ciphertext.bin")
CIPHERTEXT_SHA=$(shasum -a 256 "$TEST_DIR/ciphertext.bin" | awk '{print $1}')
PHOTO_SESSION=$(uuidgen | tr '[:upper:]' '[:lower:]')
PHOTO_SUBMISSION=$(uuidgen | tr '[:upper:]' '[:lower:]')
PHOTO_IDEMPOTENCY=$(uuidgen | tr '[:upper:]' '[:lower:]')
PHOTO_OBJECT=$(uuidgen | tr '[:upper:]' '[:lower:]')
jq -n \
  --arg session "$PHOTO_SESSION" --arg submission "$PHOTO_SUBMISSION" \
  --arg idem "$PHOTO_IDEMPOTENCY" --arg object "$PHOTO_OBJECT" \
  --arg sha "$CIPHERTEXT_SHA" --arg now "$NOW" \
  --argjson bytes "$CIPHERTEXT_BYTES" --slurpfile exact "$TEST_DIR/init.json" \
  '{client_submission_id:$submission,idempotency_key:$idem,consent:{version:"pilot-consent-v1",adult_confirmed:true,share_scope:"results_and_selected_photos",accepted_at:$now},results:($exact[0].results | .local_session_id=$session),wrapped_key:{algorithm:"test-envelope"},objects:[{object_id:$object,set_number:1,pose:"front",sha256:$sha,byte_count:$bytes}]}' > "$TEST_DIR/photo-init.json"

expect_status 401 -X POST "${HEADERS[@]}" \
  -H 'x-evolv-participant-token: forged-participant-token-that-is-not-valid' \
  --data-binary "@$TEST_DIR/photo-init.json" "$API_BASE/submissions/init"
curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" "${AUTH[@]}" \
  --data-binary "@$TEST_DIR/photo-init.json" "$API_BASE/submissions/init" > "$TEST_DIR/photo-initialized.json"
PHOTO_REMOTE=$(jq -r '.submission_id' "$TEST_DIR/photo-initialized.json")
jq -e '.uploads | length == 1 and .[0].already_uploaded == false and (.[0].signed_url | type == "string")' \
  "$TEST_DIR/photo-initialized.json" >/dev/null || fail "initial photo upload authorization was invalid"

curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" "${AUTH[@]}" \
  --data-binary "@$TEST_DIR/photo-init.json" "$API_BASE/submissions/init" > "$TEST_DIR/photo-replay-before.json"
[[ "$(jq -r '.submission_id' "$TEST_DIR/photo-replay-before.json")" == "$PHOTO_REMOTE" ]] ||
  fail "pre-upload initialization replay changed submission identity"
jq -e '.uploads | length == 1 and .[0].already_uploaded == false and (.[0].signed_url | type == "string")' \
  "$TEST_DIR/photo-replay-before.json" >/dev/null || fail "pre-upload replay did not renew authorization"

jq '.objects[0].pose="side"' "$TEST_DIR/photo-init.json" > "$TEST_DIR/photo-expanded-replay.json"
expect_status 400 -X POST "${HEADERS[@]}" "${AUTH[@]}" \
  --data-binary "@$TEST_DIR/photo-expanded-replay.json" "$API_BASE/submissions/init"

jq -n --arg submission "$PHOTO_REMOTE" --arg idem "$PHOTO_IDEMPOTENCY" \
  '{submission_id:$submission,idempotency_key:$idem}' > "$TEST_DIR/photo-complete.json"
curl "${CURL_TIMEOUT[@]}" -sS -o "$TEST_DIR/photo-missing.json" -X POST \
  "${HEADERS[@]}" "${AUTH[@]}" --data-binary "@$TEST_DIR/photo-complete.json" \
  "$API_BASE/submissions/complete"
jq -e '.code == "incomplete_upload"' "$TEST_DIR/photo-missing.json" >/dev/null ||
  fail "missing selected photo did not block completion"

PHOTO_UPLOAD_URL=$(jq -r '.uploads[0].signed_url' "$TEST_DIR/photo-replay-before.json")
expect_status 200 -X PUT -H 'content-type: application/octet-stream' \
  -H 'cache-control: no-store' -H 'x-upsert: false' \
  --data-binary "@$TEST_DIR/ciphertext.bin" "$PHOTO_UPLOAD_URL"

curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" "${AUTH[@]}" \
  --data-binary "@$TEST_DIR/photo-init.json" "$API_BASE/submissions/init" > "$TEST_DIR/photo-replay-after.json"
[[ "$(jq -r '.submission_id' "$TEST_DIR/photo-replay-after.json")" == "$PHOTO_REMOTE" ]] ||
  fail "post-upload initialization replay changed submission identity"
jq -e '.uploads | length == 1 and .[0].already_uploaded == true and (.[0] | has("signed_url") | not)' \
  "$TEST_DIR/photo-replay-after.json" >/dev/null || fail "uploaded object was not recovered idempotently"

curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" "${AUTH[@]}" \
  --data-binary "@$TEST_DIR/photo-complete.json" "$API_BASE/submissions/complete" > "$TEST_DIR/photo-receipt-one.json"
curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" "${AUTH[@]}" \
  --data-binary "@$TEST_DIR/photo-complete.json" "$API_BASE/submissions/complete" > "$TEST_DIR/photo-receipt-two.json"
[[ "$(jq -r '.receipt_code' "$TEST_DIR/photo-receipt-one.json")" == "$(jq -r '.receipt_code' "$TEST_DIR/photo-receipt-two.json")" ]] ||
  fail "selected-photo completion replay changed the receipt"

stage "wrong-size selected-photo recovery"
WRONG_SESSION=$(uuidgen | tr '[:upper:]' '[:lower:]')
WRONG_SUBMISSION=$(uuidgen | tr '[:upper:]' '[:lower:]')
WRONG_IDEMPOTENCY=$(uuidgen | tr '[:upper:]' '[:lower:]')
WRONG_OBJECT=$(uuidgen | tr '[:upper:]' '[:lower:]')
jq --arg session "$WRONG_SESSION" --arg submission "$WRONG_SUBMISSION" \
  --arg idem "$WRONG_IDEMPOTENCY" --arg object "$WRONG_OBJECT" \
  '.client_submission_id=$submission | .idempotency_key=$idem | .results.local_session_id=$session | .objects[0].object_id=$object' \
  "$TEST_DIR/photo-init.json" > "$TEST_DIR/wrong-init.json"
curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" "${AUTH[@]}" \
  --data-binary "@$TEST_DIR/wrong-init.json" "$API_BASE/submissions/init" > "$TEST_DIR/wrong-initialized.json"
WRONG_REMOTE=$(jq -r '.submission_id' "$TEST_DIR/wrong-initialized.json")
WRONG_UPLOAD_URL=$(jq -r '.uploads[0].signed_url' "$TEST_DIR/wrong-initialized.json")
expect_status 200 -X PUT -H 'content-type: application/octet-stream' \
  -H 'cache-control: no-store' -H 'x-upsert: false' \
  --data-binary "@$TEST_DIR/wrong-size.bin" "$WRONG_UPLOAD_URL"
jq -n --arg submission "$WRONG_REMOTE" --arg idem "$WRONG_IDEMPOTENCY" \
  '{submission_id:$submission,idempotency_key:$idem}' > "$TEST_DIR/wrong-complete.json"
curl "${CURL_TIMEOUT[@]}" -sS -o "$TEST_DIR/wrong-size-response.json" -X POST \
  "${HEADERS[@]}" "${AUTH[@]}" --data-binary "@$TEST_DIR/wrong-complete.json" \
  "$API_BASE/submissions/complete"
jq -e '.code == "upload_size_mismatch"' "$TEST_DIR/wrong-size-response.json" >/dev/null ||
  fail "wrong-size selected photo did not block completion"

curl "${CURL_TIMEOUT[@]}" -sS -X POST "${HEADERS[@]}" "${AUTH[@]}" \
  --data-binary "@$TEST_DIR/wrong-init.json" "$API_BASE/submissions/init" > "$TEST_DIR/wrong-retry.json"
jq -e '.uploads | length == 1 and .[0].already_uploaded == false and (.[0].signed_url | type == "string")' \
  "$TEST_DIR/wrong-retry.json" >/dev/null || fail "wrong-size object did not receive a safe replacement authorization"
WRONG_RETRY_URL=$(jq -r '.uploads[0].signed_url' "$TEST_DIR/wrong-retry.json")
expect_status 200 -X PUT -H 'content-type: application/octet-stream' \
  -H 'cache-control: no-store' -H 'x-upsert: false' \
  --data-binary "@$TEST_DIR/ciphertext.bin" "$WRONG_RETRY_URL"
expect_status 200 -X POST "${HEADERS[@]}" "${AUTH[@]}" \
  --data-binary "@$TEST_DIR/wrong-complete.json" "$API_BASE/submissions/complete"

stage "participant deletion"
jq -n --arg code "$DELETION_CODE" '{deletion_code:$code}' > "$TEST_DIR/delete.json"
expect_status 200 -X POST "${HEADERS[@]}" --data-binary "@$TEST_DIR/delete.json" "$API_BASE/delete"
expect_status 401 -X POST "${HEADERS[@]}" "${AUTH[@]}" --data '{}' "$API_BASE/status"
print "Live invite reuse, unauthorized access, separate ongoing consent, replay, and deletion gates passed."
