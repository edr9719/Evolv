#!/bin/zsh
set -euo pipefail

SCRIPT_DIR=${0:A:h}
REPO_ROOT=${SCRIPT_DIR:h}
TEST_DIR=$(mktemp -d "${TMPDIR:-/tmp}/evolv-validation-stats.XXXXXX")
cleanup() {
  [[ "$TEST_DIR" == *evolv-validation-stats.* ]] && rm -rf -- "$TEST_DIR"
}
trap cleanup EXIT INT TERM

fail() {
  print -u2 "Validation-statistics self-test failed: $1"
  exit 1
}

generate_fixture() {
  local destination=$1
  local calibration_count=$2
  local heldout_count=$3
  ruby -rcsv -e '
    destination, calibration_count, heldout_count = ARGV
    headers = %w[participant_id split comparison_id region expected_condition result_status evidence_strength feature_baseline feature_current pose_match pose_spread threshold_set_identifier body_type skin_tone clothing device environment]
    body_types = %w[slender average broad]
    skin_tones = %w[light medium dark]
    devices = %w[iPhone15 iPhone16]
    environments = %w[indoor_daylight indoor_diffuse]
    CSV.open(destination, "w", write_headers: true, headers: headers) do |csv|
      calibration_count.to_i.times do |index|
        participant = format("C%03d", index + 1)
        4.times do |repeat|
          [["shoulders", "high"], ["chest", "high"], ["waist", "medium"], ["arms", "low"]].each do |region, strength|
            csv << [participant, "calibration", "cal-#{index}-#{repeat}", region, "stable_repeat", "stable", strength, 1.0, 1.001, 0.96, 0.004, "candidate-v1", body_types[index % 3], skin_tones[index % 3], index.even? ? "fitted" : "minimal", devices[index % 2], environments[index % 2]]
          end
        end
      end
      heldout_count.to_i.times do |index|
        participant = format("H%03d", index + 1)
        metadata = [body_types[index % 3], skin_tones[index % 3], index.even? ? "fitted" : "minimal", devices[index % 2], environments[index % 2]]
        4.times do |repeat|
          statuses = {
            "shoulders" => ["high", "stable"],
            "chest" => ["high", "stable"],
            "waist" => ["medium", index == 1 && repeat.zero? ? "unavailable" : (index.zero? && repeat.zero? ? "increase" : "stable")],
            "arms" => ["low", [1, 2].include?(index) && repeat.zero? ? "unavailable" : (index.zero? && repeat < 2 ? "increase" : "stable")]
          }
          statuses.each do |region, (strength, status)|
            current = status == "increase" ? 1.1 : 1.001
            csv << [participant, "heldout", "held-#{index}-#{repeat}", region, "stable_repeat", status, strength, 1.0, current, 0.96, 0.004, "candidate-v1", *metadata]
          end
        end
      end
    end
  ' "$destination" "$calibration_count" "$heldout_count"
}

generate_fixture "$TEST_DIR/passing.csv" 10 100
PASSING_SHA=$(shasum -a 256 "$TEST_DIR/passing.csv" | awk '{ print $1 }')
jq -n --arg digest "$PASSING_SHA" \
  '{schema_version:1,repeatability_input_sha256:$digest,reviewer_identifier:"self-test-reviewer",reviewed_at:"2026-08-12T00:00:00Z",material_disparity_found:false,notes:"Synthetic self-test only."}' \
  > "$TEST_DIR/review.json"
"$SCRIPT_DIR/evolv-validation-stats" "$TEST_DIR/passing.csv" "$TEST_DIR/passing.json" "$TEST_DIR/review.json"
jq -e '.promote_to_validated_v1 == true and .heldout_repeatability.participant_false_change_events == 1' \
  "$TEST_DIR/passing.json" >/dev/null || fail "a valid held-out fixture did not pass"

ruby -rcsv -e '
  results, destination = ARGV
  rows = CSV.read(results, headers: true).map(&:to_h)
  headers = %w[pseudonymous_subject split consent_classification age_band body_type skin_tone clothing device environment scan_count notes]
  CSV.open(destination, "w", write_headers: true, headers: headers) do |csv|
    rows.group_by { |row| row["participant_id"] }.each_value do |values|
      row = values.first
      csv << [row["participant_id"], row["split"], "results_only", "25-34", row["body_type"], row["skin_tone"], row["clothing"], row["device"], row["environment"], 5, "synthetic self-test"]
    end
  end
' "$TEST_DIR/passing.csv" "$TEST_DIR/participants.csv"
"$SCRIPT_DIR/evolv-lock-validation-split" "$TEST_DIR/participants.csv" "$TEST_DIR/split-lock.json" >/dev/null
"$SCRIPT_DIR/evolv-phase5-study-gate" \
  "$TEST_DIR/participants.csv" "$TEST_DIR/split-lock.json" "$TEST_DIR/passing.csv" \
  "$TEST_DIR/review.json" "$TEST_DIR/study-gate.json"
jq -e '.phase5_human_gate_passed == true' "$TEST_DIR/study-gate.json" >/dev/null ||
  fail "the integrated human-validation gate rejected a valid fixture"
if "$SCRIPT_DIR/evolv-lock-validation-split" \
    "$TEST_DIR/participants.csv" "$TEST_DIR/split-lock.json" >/dev/null 2>&1; then
  fail "the participant split lock allowed overwrite"
fi

generate_fixture "$TEST_DIR/too-small.csv" 5 10
"$SCRIPT_DIR/evolv-validation-stats" "$TEST_DIR/too-small.csv" "$TEST_DIR/too-small.json"
jq -e '.promote_to_validated_v1 == false and .promotion_gates.minimum_30_participants == false' \
  "$TEST_DIR/too-small.json" >/dev/null || fail "an undersized study was not rejected"

ruby -rcsv -e '
  source, destination = ARGV
  table = CSV.read(source, headers: true)
  rows = table.map(&:to_h)
  rows.first["participant_id"] = "OVERLAP"
  heldout = rows.find { |row| row["split"] == "heldout" }
  heldout["participant_id"] = "OVERLAP"
  CSV.open(destination, "w", write_headers: true, headers: table.headers) do |csv|
    rows.each { |row| csv << row }
  end
' "$TEST_DIR/too-small.csv" "$TEST_DIR/overlap.csv"
if "$SCRIPT_DIR/evolv-validation-stats" "$TEST_DIR/overlap.csv" >/dev/null 2>&1; then
  fail "participant split leakage was accepted"
fi

print "Validation-statistics self-tests passed."
